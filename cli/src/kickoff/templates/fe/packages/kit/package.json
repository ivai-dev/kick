{
  "name": "@kickoff/kit",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Plugin-owned runtime for kickoff FE v0: router, shells, demo bar, release scope, checks. Replaced wholesale on plugin update; do not edit in projects.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./e2e": "./e2e/index.ts",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./foundation.css": "./styles/foundation.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/history": "^1.162.4",
    "@tanstack/react-router": "^1.170.41",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0"
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
