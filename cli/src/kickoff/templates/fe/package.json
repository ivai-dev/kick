{
  "name": "kickoff-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:artifact": "pnpm --filter web build:artifact",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter web e2e",
    "manifest": "node --experimental-strip-types --no-warnings packages/kit/scripts/manifest.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
