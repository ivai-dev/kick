{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kickoff features.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "epics"],
  "$defs": {
    "i18n": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } } }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^E[0-9]+$" },
          "name": { "type": "string" },
          "goal": { "type": "string" },
          "release": { "type": "string" },
          "areas": { "type": "array", "items": { "type": "string" } },
          "i18n": { "$ref": "#/$defs/i18n" },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "release", "prio"],
              "properties": {
                "id": { "type": "string", "pattern": "^F[0-9]+\\.[0-9]+$" },
                "name": { "type": "string" },
                "release": { "type": "string" },
                "prio": { "enum": ["P0", "P1", "P2"] },
                "platforms": { "type": "string" },
                "screens": { "type": "array", "items": { "type": "string" } },
                "wbs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" } },
                "status": { "enum": ["active", "removed"] },
                "removed_by": { "type": "string" },
                "estimate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["likely"],
                  "properties": {
                    "min": { "type": "number", "minimum": 0 },
                    "likely": { "type": "number", "minimum": 0 },
                    "max": { "type": "number", "minimum": 0 },
                    "confidence": { "enum": ["low", "medium", "high"] },
                    "basis": { "type": "string" }
                  }
                },
                "i18n": { "$ref": "#/$defs/i18n" }
              }
            }
          }
        }
      }
    }
  }
}
